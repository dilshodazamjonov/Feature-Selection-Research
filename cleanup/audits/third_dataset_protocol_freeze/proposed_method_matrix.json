      "lasso_adapter": "absolute_coefficient_magnitude_with_zero_coefficients_as_valid_tied_block",
      "boruta_adapter": "ordered_confirmed_tentative_rejected_state_blocks_with_tied_midranks_when_no_authentic_within_state_rank",
